{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 公開リポジトリなので account_id やシークレットはここに書かない。
  // account_id は wrangler login の状態か CLOUDFLARE_ACCOUNT_ID で渡す。
  "name": "portfolio-restricted",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // 入口を restricted.p1ass.com だけにするため、workers.dev とプレビュー用の URL は使わない。
  "workers_dev": false,
  "preview_urls": false,
  // DNS レコードと証明書はデプロイ時に Cloudflare が作る。
  "routes": [{ "pattern": "restricted.p1ass.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "portfolio-restricted" }],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      // アカウント内の rate limit binding ごとに一意な正の整数。
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
